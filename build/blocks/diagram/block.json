{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "forwp/diagram",
  "version": "2.0.0",
  "title": "4WP Diagram",
  "category": "forwp-advanced-code",
  "icon": "chart-area",
  "description": "Mermaid diagram with live preview, inline SVG, and PNG for SEO.",
  "keywords": [
    "4wp",
    "diagram",
    "mermaid",
    "flowchart",
    "sequence"
  ],
  "textdomain": "4wp-advanced-code",
  "attributes": {
    "code": {
      "type": "string",
      "default": "flowchart TD\n    %% steps: A,B,C\n    A[Start] --> B{Decision}\n    B -->|Yes| C[Done]\n    B -->|No| A"
    },
    "svg": {
      "type": "string",
      "default": ""
    },
    "pngId": {
      "type": "number",
      "default": 0
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "light",
        "dark"
      ]
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "forwp-advanced-code/ide",
  "version": "1.0.0",
  "title": "4WP IDE Wizard",
  "category": "forwp-advanced-code",
  "icon": {
    "src": "<svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 4h16a1 1 0 011 1v14a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1zm1 2v12h9V6H5zm10 0v12h4V6h-4zM7 8h5v1.5H7V8zm0 3h5v1.5H7V11z\"/></svg>"
  },
  "description": "VS Code–style wizard: one WordPress hook at a time, with practice in a PHP editor.",
  "keywords": [
    "4wp",
    "ide",
    "wizard",
    "hooks",
    "php",
    "practice",
    "vscode"
  ],
  "example": {
    "viewportWidth": 960
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "hookType": {
      "type": "string",
      "default": "action"
    },
    "hookSlug": {
      "type": "string",
      "default": "wp_head"
    },
    "tourMode": {
      "type": "string",
      "default": "single"
    },
    "selectedHooks": {
      "type": "array",
      "default": []
    }
  },
  "textdomain": "4wp-advanced-code",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}